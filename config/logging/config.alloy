discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.pods.receiver]
}

// Give every stream a level label, so error rates are a stream selector
// ({app="x", level="error"}) and Grafana colours the lines.
loki.process "pods" {
  forward_to = [loki.write.default.receiver]

  // loki.source.kubernetes can send a pod's last line again when it reopens
  // the log: every hour before v1.21.3, and still whenever Alloy restarts.
  // Loki keeps one copy, but once that line is a week old
  // (reject_old_samples_max_age) it answers 400, which Alloy counts as a
  // dropped batch; a quiet local-path-provisioner fired Log Shipping Dropping
  // Entries hourly that way. Loki would refuse these lines anyway, so drop
  // them here.
  stage.drop {
    older_than          = "167h"
    drop_counter_reason = "older_than_loki_accepts"
  }

  // Arcus services (config/extrafiles/logback.xml) log one event per line as
  // "<level letter><MMdd> <HH:mm:ss.SSS> ...", followed by the stack trace
  // when there is one. Older logback.xml copies wrap the start in colour
  // codes, which are stripped so the first character is the level.
  stage.match {
    selector = "{app=~\"api-bridge|client-bridge|driver-services|history-service|hub-bridge|ivr-callback-server|notification-services|platform-services|rule-service|scheduler-service|subsystem-service|modelmanager\"}"

    stage.replace {
      expression = "(\\x1b\\[[0-9;]*m)"
      replace    = ""
    }
    stage.multiline {
      firstline     = "^[TDIWE]\\d{4} \\d{2}:\\d{2}:\\d{2}\\.\\d{3} "
      max_wait_time = "3s"
    }
    stage.regex {
      expression = "^(?P<level>[TDIWE])\\d{4} "
    }
    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"E\" }}error{{ else if eq .Value \"W\" }}warn{{ else if eq .Value \"I\" }}info{{ else if eq .Value \"D\" }}debug{{ else }}trace{{ end }}"
    }
    stage.labels {
      values = { level = "" }
    }
  }

  // Everything else (Grafana, Loki, Alloy, Traefik, MetalLB) logs logfmt with
  // a level field; lines that aren't logfmt just get no level label.
  stage.match {
    selector = "{app!~\"api-bridge|client-bridge|driver-services|history-service|hub-bridge|ivr-callback-server|notification-services|platform-services|rule-service|scheduler-service|subsystem-service|modelmanager\"}"

    stage.logfmt {
      mapping = { level = "" }
    }
    stage.template {
      source   = "level"
      template = "{{ $l := ToLower .Value }}{{ if or (eq $l \"eror\") (eq $l \"err\") (eq $l \"fatal\") (eq $l \"crit\") }}error{{ else if or (eq $l \"warning\") (eq $l \"wrn\") }}warn{{ else if eq $l \"dbug\" }}debug{{ else }}{{ $l }}{{ end }}"
    }
    stage.labels {
      values = { level = "" }
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki-service.default.svc.cluster.local:3100/loki/api/v1/push"
  }
}
