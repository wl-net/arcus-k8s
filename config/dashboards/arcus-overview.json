              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 61,
      "targets": [
        {
          "expr": "sum(count_over_time({app=~\".+\"} |~ \"ERROR|Exception\" [1m])) by (app)",
          "legendFormat": "{{app}}",
          "refId": "A"
