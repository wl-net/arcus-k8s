    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 108,
      "title": "Ingress (Traefik)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "id": 200,
      "targets": [
        {
          "expr": "sum by (svc) (label_replace(label_replace(sum by (service) (rate(traefik_service_requests_total[5m])), \"svc\", \"$1\", \"service\", \"(.+)\"), \"svc\", \"$1\", \"service\", \"default-(.+?)(?:-service)?-[0-9]+@kubernetes\"))",
          "legendFormat": "{{svc}}",
          "refId": "A"
        }
      ],
      "title": "Requests by Service (/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "id": 201,
      "targets": [
        {
          "expr": "sum by (class) (label_replace(rate(traefik_entrypoint_requests_total{entrypoint=~\"web|websecure\", code=~\"[1-5]..\"}[5m]), \"class\", \"${1}xx\", \"code\", \"([1-5])..\"))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ],
      "title": "Responses by Status Class (/s)",
      "type": "timeseries",
      "description": "All requests arriving at Traefik on ports 80/443, including ones that matched no route."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "id": 202,
      "targets": [
        {
          "expr": "sum by (svc) (label_replace(label_replace(sum by (service) (rate(traefik_service_requests_total{code=~\"5..\"}[5m])) / sum by (service) (rate(traefik_service_requests_total[5m])), \"svc\", \"$1\", \"service\", \"(.+)\"), \"svc\", \"$1\", \"service\", \"default-(.+?)(?:-service)?-[0-9]+@kubernetes\"))",
          "legendFormat": "{{svc}}",
          "refId": "A"
        }
      ],
      "title": "5xx Error Ratio by Service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "id": 203,
      "targets": [
        {
          "expr": "sum by (svc) (label_replace(label_replace(sum by (service) (rate(traefik_service_request_duration_seconds_sum{protocol!=\"websocket\"}[5m])) / sum by (service) (rate(traefik_service_request_duration_seconds_count{protocol!=\"websocket\"}[5m])), \"svc\", \"$1\", \"service\", \"(.+)\"), \"svc\", \"$1\", \"service\", \"default-(.+?)(?:-service)?-[0-9]+@kubernetes\"))",
          "legendFormat": "{{svc}} avg",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{protocol!=\"websocket\"}[5m])))",
          "legendFormat": "all services p95",
          "refId": "B"
        }
      ],
      "title": "Latency by Service (excl. WebSocket)",
      "type": "timeseries",
      "description": "Average per service, plus p95 across all services. Traefik's default histogram buckets are coarse (0.1s, 0.3s, 1.2s, 5s), so the p95 is approximate."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "id": 204,
      "targets": [
        {
          "expr": "sum by (entrypoint) (traefik_open_connections{entrypoint=~\"web|websecure\"})",
          "legendFormat": "{{entrypoint}}",
          "refId": "A"
        }
      ],
      "title": "Open Connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Days until the TLS certificate served by Traefik expires. cert-manager renews 30 days before expiry, so less than 28 days means a renewal has been missed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "unit": "suffix: days",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 28
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "id": 205,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "min by (cn) ((traefik_tls_certs_not_after - time()) / 86400)",
          "legendFormat": "{{cn}}",
          "refId": "A"
        }
      ],
      "title": "TLS Certificate Expiry",
      "type": "stat"
    },
    {
